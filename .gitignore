node_modules
.DS_Store
*.log
dist/*.tgz
dist/browser/
examples/slot-symbol-prefab/dist/

# Reproducible local verification output; regenerate with the documented gate.
dist/declaration-audit.json

# Release outputs are generated by prepare/prepack, never committed.
/dist/

# Results brought back from a local machine are kept, their logs included.
!local-results/**/*.log
# Full-size pictures stay on the machine that took them; the sheets beside them are committed.
local-results/**/full/

# Raw pictures of a run are converted to JPEG beside them; the PNGs are not kept.
local-results/**/*-raw/
