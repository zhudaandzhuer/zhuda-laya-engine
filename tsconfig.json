{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "packages/types/index.d.ts",
    "packages/core/**/*.ts",
    "src/**/*.ts",
    "packages/compiler/**/*.ts",
    "examples/**/*.ts",
    "packages/demo/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "vendor"
  ]
}
