{
  "name": "zhuda-laya-engine",
  "version": "1.17.0",
  "description": "豬大 LayaAir 引擎 (zhuda-laya-engine) — 基於 LayaAir 官方 (layabox/LayaAir 3.4.2) 打造的豬大 AI-Agent-Friendly 開源分支版本，內建 Zero-IDE 極速打包、DAG 拓撲守衛、AST 自動反射、靜態資產 ΔE00 校準與 MCP 語料伺服器",
  "private": false,
  "license": "MIT",
  "author": "豬大 (zhudaandzhuer) <https://github.com/zhudaandzhuer>",
  "homepage": "https://github.com/zhudaandzhuer/zhuda-laya-engine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhudaandzhuer/zhuda-laya-engine.git"
  },
  "bugs": {
    "url": "https://github.com/zhudaandzhuer/zhuda-laya-engine/issues"
  },
  "upstream": {
    "name": "LayaAir Official Engine (Layabox)",
    "officialWebsite": "https://layaair.com/",
    "officialRepository": "https://github.com/layabox/LayaAir",
    "baseVersion": "3.4.2",
    "edition": "Zhuda AI-Agent-Friendly Fork / Branch Edition"
  },
  "type": "module",
  "main": "./dist/sdk/zhuda-laya-engine.cjs",
  "module": "./dist/sdk/zhuda-laya-engine.esm.js",
  "types": "./packages/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./packages/types/index.d.ts",
      "import": "./dist/sdk/zhuda-laya-engine.esm.js",
      "require": "./dist/sdk/zhuda-laya-engine.cjs"
    },
    "./core": {
      "types": "./packages/types/index.d.ts",
      "import": "./dist/sdk/zhuda-laya-engine.esm.js",
      "require": "./dist/sdk/zhuda-laya-engine.cjs"
    },
    "./compiler": "./packages/compiler/zhuda-build.mjs",
    "./doctor": "./packages/compiler/zhuda-doctor.mjs",
    "./mcp-server": "./packages/mcp-server/index.mjs",
    "./types": "./packages/types/index.d.ts",
    "./compiler/consumer": "./packages/compiler/consumer-build.mjs",
    "./browser": {
      "types": "./packages/types/browser.d.ts"
    },
    "./demo": {
      "types": "./packages/types/demo/index.d.ts",
      "import": "./dist/sdk/zhuda-laya-demo.esm.js",
      "require": "./dist/sdk/zhuda-laya-demo.cjs"
    },
    "./min": {
      "types": "./packages/types/index.d.ts",
      "import": "./dist/sdk/zhuda-laya-engine.min.esm.js",
      "require": "./dist/sdk/zhuda-laya-engine.min.cjs"
    }
  },
  "bin": {
    "zhuda-laya-build": "./packages/compiler/zhuda-build.mjs",
    "zhuda-laya-doctor": "./packages/compiler/zhuda-doctor.mjs",
    "zhuda-laya-init": "./packages/compiler/zhuda-init.mjs",
    "zhuda-visual-contract": "./packages/compiler/visual-contract-audit.mjs",
    "zhuda-prefab-check": "./packages/compiler/prefab-check.mjs",
    "zhuda-layout": "./packages/compiler/zhuda-layout.mjs",
    "zhuda-laya-accept": "./packages/compiler/consumer-accept.mjs",
    "zhuda-laya-watch": "./packages/compiler/prefab-watch.mjs",
    "zhuda-prefab-editor": "./packages/compiler/prefab-editor.mjs",
    "zhuda-model-editor": "./packages/compiler/model-editor.mjs",
    "zhuda-laya-mcp": "./packages/mcp-server/index.mjs",
    "zhuda-laya-browser-sdk": "./packages/compiler/browser-sdk.mjs",
    "zhuda-sequence-check": "./packages/ci-gate/verify-sequence.mjs",
    "zhuda-film-export": "./packages/ci-gate/export-film.mjs",
    "zhuda-laya-minigame": "./packages/compiler/zhuda-minigame.mjs"
  },
  "files": [
    "packages",
    "vendor",
    "assets",
    "dist/sdk/*.js",
    "dist/sdk/*.cjs",
    "dist/build-manifest.json",
    "dist/asset-calibration-report.json",
    "zhuda.config.json",
    "AGENTS.md",
    "docs",
    "README.md",
    "LICENSE",
    "examples/browser-sdk",
    "examples/model-inspector",
    "examples/windows-webgpu",
    "examples/cinematic-capture"
  ],
  "keywords": [
    "layaair",
    "layaair-3.4.2",
    "zhuda-laya-engine",
    "agent-friendly",
    "ai-native",
    "game-engine",
    "webgl",
    "spine-4.2",
    "mcp-server",
    "zero-ide",
    "webgpu"
  ],
  "scripts": {
    "ast:scan": "node -e \"import('./packages/compiler/ast-scanner.mjs').then(m => m.scanAndGenerateRegistry(process.cwd()))\"",
    "typecheck": "npm run types:check && npm run ast:scan && tsc --noEmit -p tsconfig.json",
    "audit:declarations": "node scripts/audit-public-declarations.mjs",
    "build": "npm run types:runtime3d && node packages/compiler/zhuda-build.mjs",
    "doctor": "node packages/compiler/zhuda-doctor.mjs",
    "visual:audit": "node packages/compiler/visual-asset-audit.mjs",
    "visual:contract": "node packages/compiler/visual-contract-audit.mjs",
    "mcp:list": "node -e \"import('./packages/mcp-server/index.mjs').then(m => console.log(JSON.stringify(m.MCP_TOOLS_MANIFEST, null, 2)))\"",
    "agent:contract": "node packages/mcp-server/index.mjs --tool get_agent_contract",
    "test": "node --test tests/*.test.mjs",
    "pack:tarball": "npm pack --pack-destination dist",
    "verify": "npm run build && npm run typecheck && npm run audit:declarations && npm run doctor && npm run test",
    "start": "node scripts/serve.mjs dist/web 8890",
    "types:runtime3d": "node packages/compiler/runtime3d-types.mjs",
    "build:browser": "node packages/compiler/browser-sdk.mjs",
    "release:browser": "node scripts/release-browser-sdk.mjs --publish",
    "browser:pin": "node scripts/release-browser-sdk.mjs --pin",
    "browser:check": "node scripts/release-browser-sdk.mjs --check",
    "verify:prefab-browser": "node scripts/verify-prefab-browser.mjs",
    "verify:prefab-editor-responsive": "node scripts/verify-prefab-editor-responsive.mjs",
    "verify:prefab-editor-play": "node scripts/verify-prefab-editor-play.mjs",
    "verify:prefab-editor": "node scripts/verify-prefab-editor-browser.mjs",
    "verify:webgpu": "node scripts/verify-webgpu.mjs",
    "verify:webgpu-consumer": "node scripts/verify-webgpu-consumer.mjs",
    "verify:cinematic": "node scripts/verify-cinematic.mjs",
    "verify:minigame": "node scripts/verify-minigame.mjs",
    "verify:branding": "node scripts/verify-branding-browser.mjs",
    "verify:browser-sdk": "npm run build:browser && node scripts/verify-browser-sdk.mjs",
    "verify:crowd": "node scripts/verify-crowd-browser.mjs",
    "verify:model-showcase": "node scripts/verify-model-showcase.mjs",
    "verify:next-round": "node scripts/verify-next-round.mjs",
    "verify:runtime-feedback": "node scripts/verify-runtime-feedback-browser.mjs",
    "verify:slot-foundation": "node scripts/verify-slot-foundation.mjs",
    "verify:procedural": "node scripts/verify-procedural-draw.mjs",
    "verify:film": "node scripts/verify-film-scene.mjs",
    "verify:film-look": "node scripts/verify-film-look.mjs",
    "verify:film-model": "node scripts/verify-film-model.mjs",
    "verify:film-reflector": "node scripts/verify-film-reflector.mjs",
    "types:generate": "node packages/compiler/runtime3d-types.mjs",
    "types:check": "node packages/compiler/runtime3d-types.mjs --check",
    "prepare": "npm run build 1>&2",
    "lint": "eslint packages src scripts tests examples",
    "format": "prettier --write --ignore-unknown packages/core packages/compiler packages/demo packages/mcp-server packages/ci-gate src scripts tests examples eslint.config.mjs package.json tsconfig.json",
    "format:check": "prettier --check --ignore-unknown packages/core packages/compiler packages/demo packages/mcp-server packages/ci-gate src scripts tests examples eslint.config.mjs package.json tsconfig.json"
  },
  "dependencies": {
    "@webgpu/types": "0.1.74",
    "abortcontroller-polyfill": "1.7.8",
    "esbuild": "0.27.1",
    "i18next": "26.7.1",
    "meshoptimizer": "1.3.0",
    "pngjs": "7.0.0",
    "sharp": "0.35.5",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "globals": "17.14.0",
    "prettier": "3.6.2",
    "typescript-eslint": "8.46.4"
  },
  "sideEffects": false
}
