{
  "name": "zhuda-laya-engine",
  "version": "1.0.0",
  "description": "豬大 LayaAir 引擎 (zhuda-laya-engine) — 基於 LayaAir 官方 (layabox/LayaAir 3.4.2) 打造的豬大 AI-Agent-Friendly 開源分支版本，內建 Zero-IDE 極速打包、DAG 拓撲守衛、AST 自動反射、靜態資產 ΔE00 校準與 MCP 語料伺服器",
  "private": false,
  "license": "MIT",
  "author": "豬大 (zhudaandzhuer) <https://github.com/zhudaandzhuer>",
  "homepage": "https://github.com/zhudaandzhuer/zhuda-laya-engine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhudaandzhuer/zhuda-laya-engine.git"
  },
  "bugs": {
    "url": "https://github.com/zhudaandzhuer/zhuda-laya-engine/issues"
  },
  "upstream": {
    "name": "LayaAir Official Engine (Layabox)",
    "officialWebsite": "https://layaair.com/",
    "officialRepository": "https://github.com/layabox/LayaAir",
    "baseVersion": "3.4.2",
    "edition": "Zhuda AI-Agent-Friendly Fork / Branch Edition"
  },
  "type": "module",
  "main": "./dist/sdk/zhuda-laya-engine.cjs",
  "module": "./dist/sdk/zhuda-laya-engine.esm.js",
  "types": "./packages/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./packages/types/index.d.ts",
      "import": "./dist/sdk/zhuda-laya-engine.esm.js",
      "require": "./dist/sdk/zhuda-laya-engine.cjs",
      "default": "./packages/core/index.ts"
    },
    "./core": "./packages/core/index.ts",
    "./compiler": "./packages/compiler/zhuda-build.mjs",
    "./doctor": "./packages/compiler/zhuda-doctor.mjs",
    "./mcp-server": "./packages/mcp-server/index.mjs",
    "./types": "./packages/types/index.d.ts",
    "./compiler/consumer": "./packages/compiler/consumer-build.mjs"
  },
  "bin": {
    "zhuda-laya-build": "./packages/compiler/zhuda-build.mjs",
    "zhuda-laya-doctor": "./packages/compiler/zhuda-doctor.mjs",
    "zhuda-visual-contract": "./packages/compiler/visual-contract-audit.mjs",
    "zhuda-laya-mcp": "./packages/mcp-server/index.mjs"
  },
  "files": [
    "packages",
    "vendor",
    "assets",
    "dist/sdk",
    "dist/build-manifest.json",
    "dist/asset-calibration-report.json",
    "zhuda.config.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "layaair",
    "layaair-3.4.2",
    "zhuda-laya-engine",
    "agent-friendly",
    "ai-native",
    "game-engine",
    "webgl",
    "spine-4.2",
    "mcp-server",
    "zero-ide"
  ],
  "scripts": {
    "ast:scan": "node -e \"import('./packages/compiler/ast-scanner.mjs').then(m => m.scanAndGenerateRegistry(process.cwd()))\"",
    "typecheck": "npm run types:runtime3d && npm run ast:scan && tsc --noEmit -p tsconfig.json",
    "build": "npm run types:runtime3d && node packages/compiler/zhuda-build.mjs",
    "doctor": "node packages/compiler/zhuda-doctor.mjs",
    "visual:audit": "node packages/compiler/visual-asset-audit.mjs",
    "visual:contract": "node packages/compiler/visual-contract-audit.mjs",
    "mcp:list": "node -e \"import('./packages/mcp-server/index.mjs').then(m => console.log(JSON.stringify(m.MCP_TOOLS_MANIFEST, null, 2)))\"",
    "test": "node --test tests/*.test.mjs",
    "pack:tarball": "npm pack --pack-destination dist",
    "verify": "npm run build && npm run typecheck && npm run doctor && npm run test",
    "start": "python3 -m http.server 8890 --bind 127.0.0.1 --directory dist/web",
    "types:runtime3d": "node packages/compiler/runtime3d-types.mjs"
  },
  "dependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=24"
  }
}
