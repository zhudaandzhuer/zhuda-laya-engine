{
  "name": "ashfall-from-library",
  "entry": "src/Main.ts",
  "outDir": "dist/web",
  "features": [
    "core",
    "2d",
    "ui"
  ],
  "branding": {
    "mode": "engine"
  },
  "prefabPreview": "src/prefabs.ts",
  "prefabChecks": [
    {
      "id": "ashfall.courtyard",
      "state": "impact",
      "width": 1280,
      "height": 720,
      "dpr": 1,
      "cycles": 2,
      "baseline": "references/courtyard.png",
      "output": "evidence/courtyard.json",
      "browserTimeoutMs": 90000,
      "maxDiffPixels": 1000
    },
    {
      "id": "ashfall.courtyard",
      "node": "Knight",
      "state": "impact",
      "width": 1280,
      "height": 720,
      "dpr": 1,
      "cycles": 2,
      "baseline": "references/knight.png",
      "output": "evidence/knight.json",
      "browserTimeoutMs": 90000
    },
    {
      "id": "ashfall.courtyard",
      "node": "Warden",
      "state": "impact",
      "width": 1280,
      "height": 720,
      "dpr": 1,
      "cycles": 30,
      "baseline": "references/warden.png",
      "output": "evidence/warden.json",
      "browserTimeoutMs": 150000
    }
  ],
  "viewport": {
    "width": 1280,
    "height": 720,
    "scaleMode": "full"
  }
}
