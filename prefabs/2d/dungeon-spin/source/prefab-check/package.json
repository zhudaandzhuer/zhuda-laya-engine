{
  "name": "dungeon-spin-prefab-check",
  "private": true,
  "type": "module",
  "description": "The smallest game made of prefabs/2d/dungeon-spin, with the original game's three prefab checks against its reference pictures.",
  "engines": { "node": ">=24" },
  "scripts": {
    "sync": "node ../../../../scripts/sync.mjs . 2d/dungeon-spin",
    "build": "zhuda-laya-build",
    "build:candidate": "zhuda-laya-build --candidate",
    "accept:prefabs": "zhuda-laya-accept",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "doctor": "zhuda-laya-doctor --project ."
  },
  "dependencies": {
    "zhuda-laya-engine": "github:zhudaandzhuer/zhuda-laya-engine#def94aae9e7ebf5f9f35b915b54dbb4c3e5fe43c"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
